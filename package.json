{
  "name": "camellia-golden-week",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/generate-assets.ts --check && node scripts/validate-content.ts",
    "test": "node --test tests/*.test.ts",
    "build": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run validate:content && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/three": "0.185.4",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
